{
    "name": "quick-base-formula-syntax",
    "displayName": "Quickbase Formula & Query Tools",
    "description": "Syntax highlighting, snippets, and validation for Quickbase formulas and API query strings",
    "version": "1.0.0",
    "publisher": "klubnik",
    "icon": "images/icon.png",
    "repository": "https://github.com/jdklub/vscode-quickbase-formula",
    "main": "./extension.js",
    "scripts": {
        "test": "node --test"
    },
    "activationEvents": [
        "onLanguage:quickbase"
    ],
    "engines": {
        "vscode": "^1.18.0"
    },
    "categories": [
        "Languages", "QuickBase", "Quick Base"
    ],
    "license": "SEE LICENSE IN LICENSE.txt",
    "contributes": {
        "languages": [{
            "id": "quickbase",
            "aliases": ["Quickbase", "Quick Base", "quickbase"],
            "extensions": [".quickbase"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "quickbase",
            "scopeName": "source.quickbase",
            "path": "./syntaxes/quickbase.tmLanguage.json"
        }],
        "snippets": [
            {
              "language": "quickbase",
              "path": "./snippets/snippets.json"
            }
        ]
    }
}
